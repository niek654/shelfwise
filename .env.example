# Copy to .env and adjust. Generate secrets with: openssl rand -hex 32

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=change-me
SHELFWISE_SECRET_KEY=change-me-to-a-long-random-string

# --- General ----------------------------------------------------------------
SHELFWISE_PORT=8000
# Allow visitors to create accounts (the first account is always allowed and becomes admin).
SHELFWISE_ALLOW_REGISTRATION=true
SHELFWISE_MAX_UPLOAD_MB=500
# How stored files are named. Fields: {author} {authors} {title} {subtitle} {year} {isbn} {publisher} {series}
# A "/" creates a folder. Example result: "Frank Herbert/Frank Herbert - Dune (1965).epub"
SHELFWISE_FILENAME_TEMPLATE={author}/{author} - {title} ({year})

# Optionally create an admin account on startup.
# SHELFWISE_ADMIN_USERNAME=admin
# SHELFWISE_ADMIN_EMAIL=admin@example.com
# SHELFWISE_ADMIN_PASSWORD=

# --- Metadata providers -----------------------------------------------------
# Google Books works without a key but is heavily rate-limited; a free key is recommended.
# https://developers.google.com/books/docs/v1/using#APIKey
SHELFWISE_GOOGLE_BOOKS_API_KEY=
# WorldCat needs an OCLC WSKey with the "wcapi" scope. Leave empty to disable.
# https://www.oclc.org/developer/api/oclc-apis/worldcat-search-api.en.html
SHELFWISE_WORLDCAT_CLIENT_ID=
SHELFWISE_WORLDCAT_CLIENT_SECRET=
# Crossref asks for a contact email to use its faster "polite" pool.
SHELFWISE_CROSSREF_MAILTO=
